<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests hors écran : aucune fenêtre ne s'ouvre, rien n'est écrit hors des
       dossiers temporaires (ni registre, ni Bureau), aucun installeur réel lancé. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>UtilitiesManager.Tests</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UtilitiesManager.Core\UtilitiesManager.Core.csproj" />
    <ProjectReference Include="..\..\src\UtilitiesManager\UtilitiesManager.csproj" />
  </ItemGroup>

  <!-- Logique du lanceur (projet .NET Framework), compilée ici pour être testée. -->
  <ItemGroup>
    <Compile Include="..\..\src\UtilitiesManager.Launcher\RuntimeCheck.cs" Link="Launcher\RuntimeCheck.cs" />
    <Compile Include="..\..\src\UtilitiesManager.Launcher\CommandLine.cs" Link="Launcher\CommandLine.cs" />
    <Compile Include="..\..\src\UtilitiesManager.Launcher\EmbeddedApp.cs" Link="Launcher\EmbeddedApp.cs" />
    <Compile Include="..\..\src\Shared\Switches.cs" Link="Launcher\Switches.cs" />
    <Compile Include="..\..\src\Shared\AppLocations.cs" Link="Launcher\AppLocations.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
